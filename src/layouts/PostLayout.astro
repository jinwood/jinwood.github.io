---
import BaseLayout from './BaseLayout.astro'
import Tag from '../components/Tag.astro'
import { formatDate } from '../utils/formatDate'
import { siteConfig } from '../siteConfig'
import type { CollectionEntry } from 'astro:content'
interface Props { post: CollectionEntry<'blog'>; prev?: CollectionEntry<'blog'> | null; next?: CollectionEntry<'blog'> | null }
const { post, prev, next } = Astro.props
const { title, date, summary, tags, images } = post.data
const pageUrl = `${siteConfig.siteUrl}/blog/${post.id}/`
const structuredData = { '@context': 'https://schema.org', '@type': 'Article', headline: title, image: images.length ? images : [siteConfig.socialBanner], datePublished: date?.toISOString(), author: { '@type': 'Person', name: siteConfig.author }, description: summary }
---
<BaseLayout title={title} description={summary} type="article" image={images[0] ?? siteConfig.socialBanner} canonicalUrl={pageUrl} structuredData={structuredData}>
  <article>
    <header class="border-b rule py-12 text-center sm:py-20">
      <div class="mx-auto max-w-5xl"><p class="eyebrow">Published {date && formatDate(date)}</p><h1 class="display mt-6 text-[clamp(3.5rem,8vw,7.5rem)]">{title}</h1><p class="mx-auto mt-7 max-w-2xl text-lg leading-8 text-[var(--muted)]">{summary}</p><div class="mt-7 flex flex-wrap justify-center gap-2">{tags.map((tag) => <Tag text={tag} />)}</div></div>
    </header>
    <div class="grid gap-10 py-12 lg:grid-cols-[12rem_minmax(0,46rem)] lg:justify-center lg:py-16">
      <aside class="text-xs font-bold uppercase tracking-[.12em] text-[var(--muted)] lg:sticky lg:top-8 lg:h-fit"><p class="text-[var(--ink)]">By Julian Inwood</p><a class="mt-5 block text-[var(--accent)]" href={`${siteConfig.siteRepo}/blob/master/src/content/blog/${post.id}.md`}>View on GitHub ↗</a></aside>
      <div class="prose max-w-none"><slot /></div>
    </div>
    <footer class="border-t rule py-10">
      <div class="grid gap-5 sm:grid-cols-2">{prev && <a class="panel p-6" href={`/blog/${prev.id}/`}><span class="eyebrow">Previous</span><span class="mt-3 block font-serif text-2xl">{prev.data.title}</span></a>}{next && <a class="panel p-6 sm:text-right" href={`/blog/${next.id}/`}><span class="eyebrow">Next</span><span class="mt-3 block font-serif text-2xl">{next.data.title}</span></a>}</div>
      <a href="/blog/" class="arrow-link mt-8 text-sm">Back to the blog</a>
    </footer>
  </article>
</BaseLayout>
