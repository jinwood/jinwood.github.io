---
import Tag from '../components/Tag.astro'
import Pagination from '../components/Pagination.astro'
import { formatDate } from '../utils/formatDate'
import type { CollectionEntry } from 'astro:content'
interface Props { title: string; posts: CollectionEntry<'blog'>[]; initialDisplayPosts?: CollectionEntry<'blog'>[]; pagination?: { currentPage: number; totalPages: number } }
const { title, posts, initialDisplayPosts = posts, pagination } = Astro.props
const searchData = posts.map((post) => ({ title: post.data.title, summary: post.data.summary, tags: post.data.tags.join(' ').toLowerCase(), href: `/blog/${post.id}/`, date: post.data.date ? formatDate(post.data.date) : '' }))
---
<header class="grid gap-8 border-b rule py-12 lg:grid-cols-[1fr_23rem] lg:items-end lg:py-16">
  <div><p class="eyebrow">Blog</p><h1 class="display mt-4 text-7xl sm:text-8xl">{title}</h1><p class="mt-5 max-w-2xl leading-7 text-[var(--muted)]">Posts about things I’ve built, problems I’ve run into and stuff I’ve learned along the way.</p></div>
  <label><span class="mb-2 block text-xs font-bold uppercase tracking-[.13em] text-[var(--muted)]">Search posts</span><input type="search" placeholder="Search by title, topic or tag" data-search-input class="w-full rounded-full border rule bg-transparent px-5 py-3 text-sm outline-none focus:border-[var(--accent)]" /></label>
</header>
<div data-post-list>
  {initialDisplayPosts.map((post, index) => (
    <article class="group grid gap-4 border-b rule py-8 md:grid-cols-[4rem_11rem_1fr]">
      <span class="eyebrow">{String(index + 1).padStart(2, '0')}</span>
      <time class="text-xs font-bold uppercase tracking-[.08em] text-[var(--muted)]" datetime={post.data.date?.toISOString()}>{post.data.date && formatDate(post.data.date)}</time>
      <div class="max-w-3xl"><h2 class="font-serif text-3xl tracking-tight transition-colors group-hover:text-[var(--accent)] sm:text-4xl"><a href={`/blog/${post.id}/`}>{post.data.title}</a></h2><p class="mt-3 leading-7 text-[var(--muted)]">{post.data.summary}</p><div class="mt-4 flex flex-wrap gap-2">{post.data.tags.map((tag) => <Tag text={tag} />)}</div></div>
    </article>
  ))}
</div>
{pagination && pagination.totalPages > 1 && <div data-pagination><Pagination currentPage={pagination.currentPage} totalPages={pagination.totalPages} /></div>}
<script is:inline define:vars={{ searchData }}>
  const input = document.querySelector('[data-search-input]'); const list = document.querySelector('[data-post-list]'); const pager = document.querySelector('[data-pagination]'); const initial = list?.innerHTML ?? '';
  const esc = (s) => String(s).replace(/[&<>'"]/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[c]));
  input?.addEventListener('input', (event) => { const term = event.target.value.toLowerCase(); if (!term) { list.innerHTML = initial; pager?.classList.remove('hidden'); return; } const matches = searchData.filter(p => p.title.toLowerCase().includes(term) || p.summary.toLowerCase().includes(term) || p.tags.includes(term)); pager?.classList.add('hidden'); list.innerHTML = matches.length ? matches.map((p,i) => `<article class="group grid gap-4 border-b rule py-8 md:grid-cols-[4rem_11rem_1fr]"><span class="eyebrow">${String(i+1).padStart(2,'0')}</span><time class="text-xs font-bold uppercase tracking-[.08em] text-[var(--muted)]">${esc(p.date)}</time><div><h2 class="font-serif text-3xl tracking-tight sm:text-4xl"><a href="${esc(p.href)}">${esc(p.title)}</a></h2><p class="mt-3 leading-7 text-[var(--muted)]">${esc(p.summary)}</p></div></article>`).join('') : '<p class="py-16 text-center text-[var(--muted)]">Nothing matched that search.</p>'; });
</script>
