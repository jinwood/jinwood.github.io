---
import type { CollectionEntry } from 'astro:content'
import { render } from 'astro:content'
interface Props { author: CollectionEntry<'authors'> }
const { author } = Astro.props
const { Content } = await render(author)
const { name, avatar, company, email, linkedin, github } = author.data
---
<article>
  <header class="grid gap-10 border-b rule py-12 lg:grid-cols-[1fr_22rem] lg:items-end lg:py-20">
    <div><p class="eyebrow">About me</p><h1 class="display mt-5 text-[clamp(4rem,9vw,7.5rem)]">I’m Julian Inwood.</h1><p class="mt-7 max-w-2xl text-lg leading-8 text-[var(--muted)]">I’m a full-stack engineer with over a decade of experience, specialising in JavaScript, TypeScript and web technologies. I’m currently working at {company}.</p><div class="mt-7 flex flex-wrap gap-5 text-sm font-bold"><a href={linkedin}>LinkedIn ↗</a><a href={github}>GitHub ↗</a><a href={`mailto:${email}`}>Email ↗</a></div></div>
    <div class="mx-auto max-w-xs lg:mx-0"><img src={avatar} alt={name} width="420" height="420" class="aspect-square w-full rounded-lg object-cover grayscale" /></div>
  </header>
  <div class="grid gap-10 py-14 lg:grid-cols-[14rem_minmax(0,46rem)] lg:justify-center lg:py-20"><aside><p class="eyebrow">Experience</p><p class="mt-4 text-sm leading-6 text-[var(--muted)]">More about what I’ve worked on and the technologies I use.</p></aside><div class="prose max-w-none"><Content /></div></div>
</article>
