---
import type { CollectionEntry } from 'astro:content'
import { render } from 'astro:content'

interface Props {
  author: CollectionEntry<'authors'>
}

const { author } = Astro.props
const { Content } = await render(author)
const { name, avatar, occupation, company, email, linkedin, github } = author.data
---

<article>
  <div class="divide-y divide-gray-200 dark:divide-gray-700">
    <header class="flex flex-col items-center space-y-4 pb-8 pt-6">
      <img
        src={avatar}
        alt={name}
        width={192}
        height={192}
        class="h-48 w-48 rounded-full"
      />
      <div class="text-center">
        <h1 class="text-3xl font-extrabold leading-9 tracking-tight text-gray-900 dark:text-gray-100">
          {name}
        </h1>
        <p class="text-base font-medium leading-6 text-gray-500 dark:text-gray-400">
          {occupation} at {company}
        </p>
        <p class="pt-2">
          <a
            href={linkedin}
            class="text-sm text-primary-500 hover:text-primary-600 dark:hover:text-primary-400"
          >
            LinkedIn
          </a>{' '}
          ·{' '}
          <a
            href={github}
            class="text-sm text-primary-500 hover:text-primary-600 dark:hover:text-primary-400"
          >
            GitHub
          </a>{' '}
          ·{' '}
          <a
            href={`mailto:${email}`}
            class="text-sm text-primary-500 hover:text-primary-600 dark:hover:text-primary-400"
          >
            Email
          </a>
        </p>
      </div>
    </header>
    <div class="prose max-w-none pb-8 pt-8 dark:prose-invert">
      <Content />
    </div>
  </div>
</article>
