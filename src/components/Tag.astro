---
import { kebabCase } from '../utils/kebabCase'

interface Props {
  text: string
}

const { text } = Astro.props
---

<a
  href={`/tags/${kebabCase(text)}/`}
  class="mr-3 text-sm font-medium text-primary-500 hover:text-primary-600 dark:hover:text-primary-400"
>
  #{text.split(' ').join('-')}
</a>
