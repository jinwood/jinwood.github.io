---
import type { CollectionEntry } from 'astro:content'
interface Props { project: CollectionEntry<'projects'> }
const { project } = Astro.props
const { title, description, imgSrc, href, images } = project.data
const image = imgSrc ?? images[0]?.url
---
<article class="panel group flex h-full flex-col overflow-hidden transition-transform duration-300 hover:-translate-y-1">
  {image && (
    <a
      href={`/projects/${project.id}/`}
      class="grid aspect-[16/10] place-items-center overflow-hidden border-b rule bg-[var(--paper-deep)] p-3"
    >
      <img
        src={image}
        alt=""
        loading="lazy"
        class="max-h-full max-w-full rounded-sm object-contain transition-transform duration-500 group-hover:scale-[1.02]"
      />
    </a>
  )}
  <div class="flex flex-1 flex-col p-6">
    <p class="eyebrow mb-3">Project</p>
    <h3 class="font-serif text-3xl tracking-tight"><a href={`/projects/${project.id}/`}>{title}</a></h3>
    <p class="mt-3 line-clamp-3 text-sm leading-6 text-[var(--muted)]">{description}</p>
    <div class="mt-auto flex gap-4 pt-6 text-sm font-bold"><a href={`/projects/${project.id}/`}>View project →</a>{href && <a class="text-[var(--muted)] hover:text-[var(--accent)]" href={href} target="_blank" rel="noreferrer">Visit site ↗</a>}</div>
  </div>
</article>
