---
import { headerNavLinks } from '../siteConfig'
import ThemeToggle from './ThemeToggle.astro'
const { pathname } = Astro.url
const isActive = (href: string) => pathname.startsWith(href)
---
<header class="border-b rule py-6">
  <div class="flex items-center justify-between gap-6">
    <a href="/" class="text-sm font-bold tracking-tight" aria-label="Julian Inwood, home">Julian Inwood</a>
    <div class="flex items-center gap-1">
      <nav class="hidden items-center md:flex" aria-label="Main navigation">
        {headerNavLinks.map((link) => <a href={link.href} aria-current={isActive(link.href) ? 'page' : undefined} class={`px-3 py-2 text-sm transition-colors ${isActive(link.href) ? 'font-semibold text-[var(--ink)]' : 'text-[var(--muted)] hover:text-[var(--ink)]'}`}>{link.title}</a>)}
      </nav>
      <ThemeToggle />
      <button type="button" aria-label="Open menu" aria-expanded="false" class="grid h-9 w-9 place-items-center md:hidden" data-mobile-menu-button><span class="text-xl leading-none">≡</span></button>
    </div>
  </div>
  <nav class="mt-5 hidden grid-cols-2 gap-x-6 gap-y-3 border-t rule pt-5 md:hidden" data-mobile-menu aria-label="Mobile navigation">
    {headerNavLinks.map((link) => <a href={link.href} class="text-sm text-[var(--muted)]">{link.title}</a>)}
  </nav>
</header>
<script>
  const button = document.querySelector('[data-mobile-menu-button]'); const menu = document.querySelector('[data-mobile-menu]');
  button?.addEventListener('click', () => { menu?.classList.toggle('hidden'); menu?.classList.toggle('grid'); button.setAttribute('aria-expanded', String(button.getAttribute('aria-expanded') !== 'true')); });
</script>
