---
import { siteConfig } from '../siteConfig'
---
<footer class="mt-24 border-t rule py-8">
  <div class="flex flex-col justify-between gap-6 sm:flex-row sm:items-end">
    <div>
      <p class="text-sm font-bold">Julian Inwood</p>
      <p class="mt-2 text-xs font-bold uppercase tracking-[.14em] text-[var(--muted)]">© {new Date().getFullYear()} Julian Inwood</p>
    </div>
    <nav class="flex flex-wrap gap-x-5 gap-y-2 text-sm font-bold" aria-label="Social links">
      <a class="hover:text-[var(--accent)]" href={siteConfig.github}>GitHub ↗</a>
      <a class="hover:text-[var(--accent)]" href={siteConfig.linkedin}>LinkedIn ↗</a>
      <a class="hover:text-[var(--accent)]" href={`mailto:${siteConfig.email}`}>Email ↗</a>
      <a class="hover:text-[var(--accent)]" href="/feed.xml">RSS</a>
    </nav>
  </div>
</footer>
