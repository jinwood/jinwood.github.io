---
interface Props { currentPage: number; totalPages: number }
const { currentPage, totalPages } = Astro.props
const prev = currentPage > 1; const next = currentPage < totalPages
---
<nav class="flex items-center justify-between py-10 text-sm font-bold" aria-label="Pagination"><span>{prev && <a class="arrow-link" href={currentPage === 2 ? '/blog/' : `/blog/page/${currentPage - 1}/`}>Previous</a>}</span><span class="eyebrow">Page {currentPage} / {totalPages}</span><span>{next && <a class="arrow-link" href={`/blog/page/${currentPage + 1}/`}>Next</a>}</span></nav>
