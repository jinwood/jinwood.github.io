---
import BaseLayout from '../../layouts/BaseLayout.astro'
import { getCollection } from 'astro:content'
import { getSortedPosts } from '../../utils/getSortedPosts'
import { getAllTags } from '../../utils/tags'
import { kebabCase } from '../../utils/kebabCase'
import { siteConfig } from '../../siteConfig'
const tags = getAllTags(getSortedPosts(await getCollection('blog')))
---
<BaseLayout title={`Tags - ${siteConfig.author}`} description="Browse Julian Inwood's writing by topic.">
  <header class="border-b rule py-12 lg:py-20"><p class="eyebrow">Blog topics</p><h1 class="display mt-4 text-[clamp(5rem,12vw,10rem)]">Tags</h1><p class="mt-5 text-lg text-[var(--muted)]">Browse posts by topic.</p></header>
  <div class="grid gap-3 py-12 sm:grid-cols-2 lg:grid-cols-3 lg:py-16">{tags.map(([tag,count], index) => <a href={`/tags/${kebabCase(tag)}/`} class="panel group flex items-center justify-between p-5"><span><span class="mr-3 text-xs font-black text-[var(--accent)]">{String(index+1).padStart(2,'0')}</span><span class="font-serif text-xl">{tag}</span></span><span class="grid h-8 w-8 place-items-center rounded-full bg-[var(--paper-deep)] text-xs font-bold group-hover:bg-[var(--acid)] group-hover:text-black">{count}</span></a>)}</div>
</BaseLayout>
