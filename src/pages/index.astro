---
import BaseLayout from '../layouts/BaseLayout.astro'
import Card from '../components/Card.astro'
import { getCollection } from 'astro:content'
import { getSortedPosts } from '../utils/getSortedPosts'
import { formatDate } from '../utils/formatDate'
import { siteConfig } from '../siteConfig'

const posts = getSortedPosts(await getCollection('blog')).slice(0, 3)
const projects = (await getCollection('projects')).filter((p) => p.data.featured)
const author = (await getCollection('authors')).find((a) => a.id === 'default')
---

<BaseLayout>
  <div class="divide-y divide-gray-200 dark:divide-gray-700">
    <section class="space-y-2 pb-8 pt-6 md:space-y-5">
      <h1 class="text-3xl font-extrabold leading-9 tracking-tight text-gray-900 dark:text-gray-100 sm:text-4xl sm:leading-10 md:text-6xl md:leading-14">
        Hi, I'm {siteConfig.author}
      </h1>
      <p class="text-lg leading-7 text-gray-500 dark:text-gray-400">
        {author?.data.occupation} at {author?.data.company}. Occasional writer,
        based in Bristol, UK.
      </p>
      <p class="flex gap-4 pt-2 text-base leading-7">
        <a
          href="/about/"
          class="text-primary-500 hover:text-primary-600 dark:hover:text-primary-400"
        >
          About me &rarr;
        </a>
        <a
          href={siteConfig.github}
          class="text-primary-500 hover:text-primary-600 dark:hover:text-primary-400"
        >
          GitHub
        </a>
      </p>
    </section>

    <section class="py-8">
      <div class="mb-6 flex justify-between">
        <h2 class="text-2xl font-bold leading-8 tracking-tight text-gray-900 dark:text-gray-100">
          Featured Projects
        </h2>
        <a
          href="/projects/"
          class="text-primary-500 hover:text-primary-600 dark:hover:text-primary-400"
        >
          All projects &rarr;
        </a>
      </div>
      <div class="grid gap-6 sm:grid-cols-2">
        {projects.map((project) => (
          <Card project={project} />
        ))}
      </div>
    </section>

    <section class="py-8">
      <div class="mb-6 flex justify-between">
        <h2 class="text-2xl font-bold leading-8 tracking-tight text-gray-900 dark:text-gray-100">
          Latest Posts
        </h2>
        <a
          href="/blog/"
          class="text-primary-500 hover:text-primary-600 dark:hover:text-primary-400"
        >
          All posts &rarr;
        </a>
      </div>
      <ul class="divide-y divide-gray-200 dark:divide-gray-700">
        {posts.map((post) => (
          <li class="py-6">
            <article class="space-y-2">
              <dl>
                <dt class="sr-only">Published on</dt>
                <dd class="text-base font-medium leading-6 text-gray-500 dark:text-gray-400">
                  <time datetime={post.data.date?.toISOString()}>
                    {post.data.date && formatDate(post.data.date)}
                  </time>
                </dd>
              </dl>
              <h3 class="text-2xl font-bold leading-8 tracking-tight">
                <a
                  href={`/blog/${post.id}/`}
                  class="text-gray-900 dark:text-gray-100"
                >
                  {post.data.title}
                </a>
              </h3>
              <div class="prose max-w-none text-gray-500 dark:text-gray-400">
                {post.data.summary}
              </div>
            </article>
          </li>
        ))}
      </ul>
    </section>
  </div>
</BaseLayout>
