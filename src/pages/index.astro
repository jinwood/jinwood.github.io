---
import BaseLayout from '../layouts/BaseLayout.astro'
import Card from '../components/Card.astro'
import Tag from '../components/Tag.astro'
import { getCollection } from 'astro:content'
import { getSortedPosts } from '../utils/getSortedPosts'
import { formatDate } from '../utils/formatDate'
import { siteConfig } from '../siteConfig'
const posts = getSortedPosts(await getCollection('blog')).slice(0, 3)
const projects = (await getCollection('projects')).filter((p) => p.data.featured)
---

<BaseLayout>
  <section class="grid min-h-[33rem] items-end gap-10 border-b rule py-12 sm:py-16 lg:grid-cols-[1fr_20rem] lg:py-20">
    <div>
      <p class="eyebrow mb-6">Hello</p>
      <h1 class="display max-w-5xl text-[clamp(3.8rem,9vw,7.5rem)]">Hi, I’m Julian.</h1>
    </div>
    <div class="pb-2">
      <p class="text-lg leading-relaxed text-[var(--muted)]">I’m a senior software engineer based in Bristol. I write about JavaScript, TypeScript and things I’ve learned while building software.</p>
      <div class="mt-7 flex flex-wrap gap-5 text-sm"><a class="arrow-link" href="/about/">More about me</a><a class="text-link" href={siteConfig.github}>GitHub</a></div>
    </div>
  </section>

  <section class="grid gap-10 border-b rule py-14 lg:grid-cols-[.55fr_1.45fr] lg:py-20">
    <div>
      <p class="eyebrow">Work</p>
      <h2 class="display mt-4 text-5xl sm:text-6xl">Projects</h2>
      <p class="mt-5 max-w-xs leading-7 text-[var(--muted)]">A few things I’ve worked on over the years.</p>
      <a class="arrow-link mt-8 text-sm" href="/projects/">All projects</a>
    </div>
    <div class="grid gap-5 sm:grid-cols-2">{projects.map((project) => <Card project={project} />)}</div>
  </section>

  <section class="py-14 lg:py-20">
    <div class="mb-10 flex items-end justify-between gap-5"><div><p class="eyebrow">Blog</p><h2 class="display mt-3 text-5xl sm:text-6xl">Latest posts</h2></div><a href="/blog/" class="arrow-link hidden text-sm sm:inline-flex">All posts</a></div>
    <div class="border-t rule">
      {posts.map((post, index) => (
        <article class="group grid gap-4 border-b rule py-7 sm:grid-cols-[3rem_10rem_1fr_auto] sm:items-baseline">
          <span class="text-xs font-black text-[var(--accent)]">0{index + 1}</span>
          <time class="text-xs font-bold uppercase tracking-[.1em] text-[var(--muted)]" datetime={post.data.date?.toISOString()}>{post.data.date && formatDate(post.data.date)}</time>
          <div><h3 class="font-serif text-2xl tracking-tight sm:text-3xl"><a class="transition-colors group-hover:text-[var(--accent)]" href={`/blog/${post.id}/`}>{post.data.title}</a></h3><div class="mt-3 flex flex-wrap gap-2">{post.data.tags.slice(0, 2).map((tag) => <Tag text={tag} />)}</div></div>
          <span class="hidden text-2xl transition-transform group-hover:translate-x-1 sm:block">→</span>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
