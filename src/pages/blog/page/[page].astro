---
import BaseLayout from '../../../layouts/BaseLayout.astro'
import ListLayout from '../../../layouts/ListLayout.astro'
import { getCollection } from 'astro:content'
import { getSortedPosts } from '../../../utils/getSortedPosts'
import { siteConfig } from '../../../siteConfig'

export const POSTS_PER_PAGE = 5

export async function getStaticPaths() {
  const posts = getSortedPosts(await getCollection('blog'))
  const totalPages = Math.ceil(posts.length / POSTS_PER_PAGE)
  const pages = Array.from({ length: Math.max(totalPages - 1, 0) }, (_, i) => i + 2)
  return pages.map((page) => ({ params: { page: String(page) }, props: { page, totalPages, posts } }))
}

const { page, totalPages, posts } = Astro.props
const initialDisplayPosts = posts.slice((page - 1) * POSTS_PER_PAGE, page * POSTS_PER_PAGE)
const pagination = { currentPage: page, totalPages }
---

<BaseLayout title={`Blog - ${siteConfig.author}`} description={siteConfig.description}>
  <ListLayout
    title="All Posts"
    posts={posts}
    initialDisplayPosts={initialDisplayPosts}
    pagination={pagination}
  />
</BaseLayout>
