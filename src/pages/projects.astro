---
import BaseLayout from '../layouts/BaseLayout.astro'
import Card from '../components/Card.astro'
import { getCollection } from 'astro:content'
import { siteConfig } from '../siteConfig'
const projects = (await getCollection('projects')).sort((a,b) => Number(b.data.featured)-Number(a.data.featured))
---
<BaseLayout title={`Projects - ${siteConfig.author}`} description="Selected product and engineering work by Julian Inwood.">
  <header class="grid gap-8 border-b rule py-12 lg:grid-cols-[1fr_25rem] lg:items-end lg:py-20"><div><p class="eyebrow">Work</p><h1 class="display mt-4 text-[clamp(5rem,12vw,10rem)]">Projects</h1></div><p class="text-lg leading-8 text-[var(--muted)]">A few things I’ve worked on over the years.</p></header>
  <div class="grid gap-6 py-12 md:grid-cols-2 lg:py-16">{projects.map((project) => <Card project={project} />)}</div>
</BaseLayout>
